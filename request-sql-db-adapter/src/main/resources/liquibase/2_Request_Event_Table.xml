<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <changeSet author="raffaeleesposito" id="create-request-event-table">
        <createTable tableName="request_event">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="request_uuid" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="from_status" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="to_status" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(4000)">
                <constraints nullable="true"/>
            </column>
            <column name="published_request_uuid" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="decided_on_version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="published_at" type="DATETIME(6)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <createIndex tableName="request_event" indexName="idx_request_event_request_uuid">
            <column name="request_uuid"/>
            <column name="id"/>
        </createIndex>

        <createIndex tableName="request_event" indexName="idx_request_event_published_at">
            <column name="published_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
